{
  "name": "crawlpilot-pro",
  "private": true,
  "version": "0.1.0",
  "description": "CrawlPilot Pro: internal recipe builder (fork of crawlpilot)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "zip": "npm run build && rm -rf dist/.vite && rm -f crawlpilot-pro.zip && cd dist && zip -r ../crawlpilot-pro.zip . -x '*.DS_Store' -x '*.map' -x '*.md' && cd .. && node scripts/release-check.mjs crawlpilot-pro.zip",
    "deadcode": "npx --yes knip@5 --no-progress",
    "e2e": "npm run build && playwright test",
    "crawler:build": "vite build --config vite.crawler.config.ts && vite build --config vite.crawler.config.ts --mode worker",
    "pro:mock": "vite build --config vite.crawler.config.ts --mode mock --logLevel warn && node src/pro/crawler/dist/mock-backend.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github-work/crawlpilot/crawlpilot-pro.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.35",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@mozilla/readability": "^0.6.0",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "fflate": "^0.8.3",
    "i18next": "^26.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
