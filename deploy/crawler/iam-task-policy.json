{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TakeJobs",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:SendMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:{{REGION}}:{{ACCOUNT_ID}}:crawlpilot-crawl-jobs"
    },
    {
      "Sid": "DeadLetter",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:{{REGION}}:{{ACCOUNT_ID}}:crawlpilot-crawl-dead"
    }
  ]
}
